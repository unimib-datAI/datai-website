{
  "name": "datai-lab-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:og-source": "node scripts/build-og.mjs",
    "import:carlo-scholar": "node scripts/import-scholar-profile.mjs",
    "audit:carlo-details": "node scripts/apply-scholar-detail-audit.mjs",
    "repair:publication-encoding": "node scripts/repair-publication-encoding.mjs",
    "audit:publications": "node scripts/refresh-scholar.mjs && node scripts/enrich-publications.mjs && node scripts/enrich-scholar-details.mjs && node scripts/validate-publications.mjs",
    "validate:publications": "node scripts/validate-publications.mjs",
    "generate:people": "node scripts/generate-people-pages.mjs",
    "predev": "npm run generate:people",
    "prebuild": "npm run generate:people",
    "prebuild:pages": "npm run generate:people",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-hosting.mjs",
    "build:pages": "vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2"
  }
}
